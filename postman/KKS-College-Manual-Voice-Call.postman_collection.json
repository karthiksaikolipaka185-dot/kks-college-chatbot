{
  "info": {
    "_postman_id": "c4d5e6f7-a8b9-4c0d-1e2f-3a4b5c6d7e8f",
    "name": "KKS College Chatbot - Manual Voice Call (Opt-In Only)",
    "description": "Manual-only Postman collection for triggering outbound Vapi AI voice calls. Separated from automated regression suites to prevent accidental calls. Requires explicit opt-in via ENABLE_OUTBOUND_CALLS=true.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Trigger Outbound Voice Call (Manual Opt-In)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{authToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"phoneNumber\": \"{{targetPhoneNumber}}\",\n  \"preferredCourse\": \"B.Tech Computer Science\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/vapi/call",
          "host": ["{{baseUrl}}"],
          "path": ["api", "vapi", "call"]
        },
        "description": "Manual execution only. Triggers outbound Vapi voice call. Guarded by pre-request check requiring ENABLE_OUTBOUND_CALLS=true."
      },
      "response": [],
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "if (pm.environment.get(\"ENABLE_OUTBOUND_CALLS\") !== \"true\") {",
              "    console.warn(\"SAFETY GUARD: Outbound voice call aborted. Set ENABLE_OUTBOUND_CALLS=true in your environment to explicitly authorize calls.\");",
              "    pm.execution.skipRequest();",
              "}"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Call initiated response structure\", function () {",
              "    var json = pm.response.json();",
              "    pm.expect(json.success).to.be.true;",
              "    pm.expect(json.message).to.include(\"Call initiated\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    }
  ]
}
