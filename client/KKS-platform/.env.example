# Frontend Environment Variables
# Copy this file to .env or .env.local for local development.
# Do NOT commit .env or .env.local files containing environment-specific URLs or secrets.

# Backend API base URL:
# - Local development: http://localhost:5000/api
# - Docker Compose (via Nginx reverse proxy): /api
# - Production (Vercel): https://your-backend-domain.vercel.app/api
VITE_API_URL=http://localhost:5000/api
